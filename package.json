{
  "name": "kot-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath scripts/hooks',{stdio:'ignore'})}catch(e){}\"",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:migrate:check": "node scripts/apply-migrations.mjs --check",
    "db:migrate:apply": "node scripts/apply-migrations.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
