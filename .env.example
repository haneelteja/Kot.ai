# ─── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── AI — Anthropic (primary, all bot replies) ─────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Model used for all customer-facing replies. Override per-tenant via llm_configs table.
# Fast/cheap default: claude-haiku-4-5-20251001
# Better quality:     claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── AI — OpenRouter (vision only, KB document image extraction) ───────────────
# https://openrouter.ai → Keys → Create key
OPENROUTER_API_KEY=sk-or-v1-...
# Free vision model for image extraction (200 req/day free tier)
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ─── Embeddings — Voyage AI (KB semantic search) ──────────────────────────────
# Free tier: 50M tokens/month — https://dash.voyageai.com
# If unset, KB falls back to keyword search (ILIKE) only.
VOYAGE_API_KEY=pa-...

# ─── WhatsApp — Meta Cloud API ────────────────────────────────────────────────
# https://developers.facebook.com → App → WhatsApp → API Setup
META_WHATSAPP_TOKEN=your-permanent-system-user-token
META_VERIFY_TOKEN=your-arbitrary-verify-string
META_PHONE_NUMBER_ID=your-phone-number-id
META_APP_SECRET=your-app-secret

# ─── WhatsApp — Twilio Sandbox (alternative provider) ────────────────────────
# https://console.twilio.com → Messaging → Try it out → WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886


# ─── Email — Resend ───────────────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ─── Redis — queue, rate-limit store, job locks ────────────────────────────────
# Local: `docker compose up -d redis` → redis://localhost:6379
# Staging/prod: a managed Redis instance (Render/Upstash/etc.)
# The app degrades gracefully (logs a warning, skips Redis-backed features) if unset.
REDIS_URL=redis://localhost:6379

# ─── Easebuzz — payments (per-tenant creds come later; this is the platform
# fallback used until SEC-02/PAY-01 land, per docs/AUDIT.md issue #4) ──────────
# https://easebuzz.in → Dashboard → API Keys (use test mode credentials first)
EASEBUZZ_MERCHANT_KEY=your-test-merchant-key
EASEBUZZ_SALT=your-test-salt
EASEBUZZ_ENV=test
EASEBUZZ_SURL=http://localhost:3000/payment/status

# ─── Error tracking — Sentry ───────────────────────────────────────────────────
# https://sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─── Scheduled admin endpoints ─────────────────────────────────────────────────
# Arbitrary secret required in the x-cron-secret header for POST /api/admin/run-insights.
CRON_SECRET=generate-a-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Used by the Next.js web app (must be NEXT_PUBLIC_ for browser access)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional / advanced — multi-model routing, alt providers, keep-alive ──────
# Only needed if you use the corresponding fallback path; safe to leave unset.
# GEMINI_API_KEY=            # alt LLM provider (lib/llm-router.ts)
# OPENAI_API_KEY=            # alt LLM provider (lib/llm-router.ts)
# OPENROUTER_REPLY_MODEL=    # overrides the default OpenRouter reply model
# BREVO_API_KEY=             # alt email provider to Resend
# BREVO_FROM_EMAIL=
# USD_TO_INR=                # exchange rate used by routes/subscriptions for USD-denominated plans
# API_SELF_URL=              # used by apps/web's keep-alive/refresh-models cron routes to ping the API
